# RiskModels API Developer Portal — Environment Variables
# Copy to .env.local for local dev. Set in Vercel Dashboard for production.

# --- Python SDK / scripts (riskmodels-py, scripts/generate_readme_assets.py) ---
# Default API base is https://riskmodels.app/api. For local Next dev, uncomment:
# RISKMODELS_BASE_URL=http://localhost:3000/api
# Requires `npm run dev` and the same Supabase + API key setup your routes need.

# Supabase (public — safe in client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# App URL (production: https://riskmodels.app, preview: Vercel preview URL)
NEXT_PUBLIC_APP_URL=https://riskmodels.app

# PostHog (client — GTM funnel + click diagnostics; sync from Doppler site_app/prd)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Gateway auth for trusted server-to-server reads from Risk_Models
# Set in Doppler as RISKMODELS_API_SERVICE_KEY
RISKMODELS_API_SERVICE_KEY=rm_service_...

# When Authorization is RISKMODELS_API_SERVICE_KEY, billing uses X-RiskModels-User-Authorization
# for a signed-in end user (same Supabase project). If that header is absent, bill this pooled user id.
# RISKMODELS_GATEWAY_BILLING_USER_ID=00000000-0000-0000-0000-000000000000

# Zarr on GCS (ERM3 history in local dev / non-Vercel): absolute path to the JSON key.
# Strongly recommended if your shell exports GOOGLE_APPLICATION_CREDENTIALS to another project —
# Next.js will not override an already-set env var from .env.local, but this name is app-specific.
# RISKMODELS_GCS_KEYFILE=/absolute/path/to/gcp-service-account-key.json

# Funds/filer/ETF/benchmark zarr trees (lib/dal/funds-zarr-reader.ts). Defaults need no config:
# ZARR_FUNDS_GCS_PREFIX defaults to rm_api_data/ERM3_Funds and, post Funds_DAG #76, each moved
# domain has its own override (set in Doppler erm3/{dev,stg,prd}; prd → Vercel via native sync):
# ZARR_FILERS_GCS_PREFIX=rm_api_data/ERM3_Filers    # filers + synthetic composites
# ZARR_ETFS_GCS_PREFIX=rm_api_data/ERM3_ETFs        # ETF sponsor holdings
# ZARR_BENCH_GCS_PREFIX=rm_api_data/ERM3_Reference  # benchmark/reference surfaces

# Supabase (server-only — NEVER expose to client)
# Same value as Risk_Models/riskmodels_com when both apps point at the shared Supabase project; copy from Doppler if needed.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (server-only — NEVER expose to client)
STRIPE_SECRET_KEY=sk_live_...   # or sk_test_... for dev

# --- Email (Resend + React Email; low-balance and other transactional mail) ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="RiskModels <service@riskmodels.app>"
# Audit BCC (default resend@riskmodels.app). Set to 0 to disable.
# RESEND_BCC_EMAIL=resend@riskmodels.app

# Cron (Vercel): API key expiry reminder emails (GET /api/cron/notify-expiring-keys).
# Set in Vercel; Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=generate_a_long_random_string

# BWMACRO admin post builder (POST /api/admin/post-builder). Bearer must match BWMACRO web/.env.local.
# Generate: openssl rand -base64 32. Sync to Vercel via scripts/doppler-vercel-allowlist.txt.
# RISKMODELS_ADMIN_TOKEN=

# --- OpenAI (server-only — powers POST /api/chat and POST /api/landing/chat) ---
# The agentic risk analyst chat (floating bubble on every page) uses
# gpt-4o-mini with tool-calling against the ERM3 DAL. The main /api/chat
# route is billed per-token + per-tool; /api/landing/chat is a keyless
# MAG7-only demo proxy with a 10-msg/hour/IP throttle. Without this key,
# both routes return 503 and the chat bubble surfaces a friendly
# "not configured yet" message.
OPENAI_API_KEY=sk-...

# --- Chat LLM backend selection (resolveAgentBackend) ---
# Priority: explicit claude-* model → Anthropic; else MOONSHOT_API_KEY → Moonshot
# (Kimi, OpenAI-compatible, cheaper); else AGENT_BACKEND=claude → Claude; else OpenAI.
# Setting MOONSHOT_API_KEY points BOTH /api/chat and /api/landing/chat at Moonshot.
# End-user billing is unchanged (priced per RiskModels capability, not per model).
# MOONSHOT_API_KEY=sk-...
# MOONSHOT_MODEL=kimi-k2.5      # or kimi-k2.6 (agentic), kimi-k2.7-code
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# ANTHROPIC_API_KEY=sk-ant-...    # (in Doppler) — claude-* models
# AGENT_BACKEND=claude            # optional: force Claude default when no Moonshot key

# --- Analyst doctrine (institutional prompt middle + tail; SSOT in BWMACRO chat_doctrine/) ---
# Without these, chat uses a minimal operational stub until deploy wires full doctrine.
# ANALYST_SYSTEM_PROMPT_APPEND='<paste markdown with {{TOOLS_AND_PERFORMANCE}} placeholder>'
# ANALYST_SYSTEM_PROMPT_APPEND_PATH=/absolute/path/to/ANALYST_SYSTEM_PROMPT_APPEND.md

# --- Optional: append a shared Bearer token to https://riskmodels.app/llms.txt for LLM crawlers ---
# Use a dedicated rm_agent_* or rm_user_* key (e.g. from POST /api/auth/provision-free).
# Intended for MAG7 (AAPL, MSFT, GOOG, AMZN, NVDA, META, TSLA) documentation examples; rate-limit and rotate as needed.
# Production: set in Doppler (erm3/prd) and sync via scripts/doppler-vercel-allowlist.txt.
# LLMS_TXT_PUBLIC_AGENT_KEY=rm_agent_live_...
