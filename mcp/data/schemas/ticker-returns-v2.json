{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ticker Returns Response",
  "type": "object",
  "required": [
    "meta",
    "data"
  ],
  "properties": {
    "resolved_via": {
      "type": "string",
      "enum": [
        "most_recent_holder"
      ],
      "description": "Present only when the modelled registry has no live row for the requested ticker and the series belongs to the security that holds it outside the modelled universe or held it most recently (e.g. delisted CTRA). Omitted for live registry rows and for answers unchanged from earlier releases (alias renames, delisted registry rows)."
    },
    "delisted": {
      "type": "boolean",
      "description": "true when the answering security is closed in the security master or flagged delisted in the registry; false when the most-recent-holder pass found it open. Absent on ordinary answers and on answers kept unchanged from earlier releases whose registry row is not flagged delisted."
    },
    "ticker_reassigned": {
      "type": "boolean",
      "description": "true when the security master shows a different security holding the ticker today that the API cannot serve (no registry row under the ticker, no daily history), so the answer is still the previous holder's series (e.g. FB keeps answering Meta while another security holds FB). Absent otherwise."
    },
    "current_holder": {
      "type": "object",
      "description": "With ticker_reassigned: the security holding the ticker today.",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "resolution_degraded": {
      "type": "boolean",
      "description": "true when the most-recent-holder check could not read its evidence and the previous answer was returned unchecked. Absent otherwise."
    },
    "meta": {
      "type": "object",
      "required": [
        "market_etf",
        "sector_etf",
        "subsector_etf"
      ],
      "properties": {
        "market_etf": {
          "type": "string",
          "description": "Market ETF ticker (e.g., SPY)"
        },
        "sector_etf": {
          "type": "string",
          "description": "Sector ETF ticker (e.g., XLK)"
        },
        "subsector_etf": {
          "type": "string",
          "description": "Subsector ETF ticker"
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "stock",
          "l1",
          "l2",
          "l3"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date in YYYY-MM-DD format"
          },
          "stock": {
            "type": "number",
            "description": "Daily gross return"
          },
          "l1": {
            "type": "number",
            "description": "Level 1 (market) hedge ratio"
          },
          "l2": {
            "type": "number",
            "description": "Level 2 (market + sector) hedge ratio"
          },
          "l3": {
            "type": "number",
            "description": "Level 3 (full multi-factor) hedge ratio"
          }
        }
      }
    },
    "_agent": {
      "type": "object",
      "description": "Agent-specific metadata",
      "properties": {
        "cost_usd": {
          "type": "number",
          "description": "Cost of this request in USD"
        },
        "latency_ms": {
          "type": "integer",
          "description": "Response latency in milliseconds"
        },
        "request_id": {
          "type": "string",
          "description": "Unique request identifier"
        },
        "confidence": {
          "type": "object",
          "properties": {
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "factors": {
              "type": "object",
              "properties": {
                "data_completeness": {
                  "type": "number"
                },
                "data_freshness": {
                  "type": "number"
                },
                "model_accuracy": {
                  "type": "number"
                },
                "historical_coverage": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
