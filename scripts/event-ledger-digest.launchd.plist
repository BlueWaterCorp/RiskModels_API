<?xml version="1.0" encoding="UTF-8"?>
<!--
  Internal Event Ledger edition, weekdays (Monday to Friday) at 07:30 local
  time (Pacific on the M4), to conrad@bwmacro.com only (the script refuses any
  other recipient for an internal edition).

  Installed 2026-11-13 as ~/Library/LaunchAgents/com.bwmacro.event-ledger-digest.plist
  (it replaced the earlier daily 07:00 client-edition agent,
  app.riskmodels.event-ledger-digest). Keep this file and the installed copy
  identical; steps are in the header of scripts/event-ledger-digest.ts
  ("The schedule").
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bwmacro.event-ledger-digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd ~/BW_Code/RiskModels_API &amp;&amp; doppler run --project erm3 --config prd -- npx tsx scripts/event-ledger-digest.ts --internal --send --advance-cursor &gt;&gt; ~/Library/Logs/event-ledger-digest.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>2</integer>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>3</integer>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>4</integer>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
